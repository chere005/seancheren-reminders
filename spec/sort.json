[
  { "name": "undated first, then by date, soonest first",
    "rows": [
      { "id": "a", "due": "2026-08-05" },
      { "id": "b" },
      { "id": "c", "due": "2026-08-02" }
    ],
    "expect": ["b", "c", "a"] },

  { "name": "a shared date keeps the stored order",
    "rows": [
      { "id": "a", "due": "2026-08-05" },
      { "id": "b", "due": "2026-08-05" },
      { "id": "c", "due": "2026-08-05" }
    ],
    "expect": ["a", "b", "c"] },

  { "name": "a subtask travels with its parent, not to the head of the list",
    "rows": [
      { "id": "p1", "due": "2026-08-05" },
      { "id": "s1", "indent": 1 },
      { "id": "p2" }
    ],
    "expect": ["p2", "p1", "s1"] },

  { "name": "every subtask in the run rides along",
    "rows": [
      { "id": "p1", "due": "2026-08-05" },
      { "id": "s1", "indent": 1, "due": "2026-08-01" },
      { "id": "s2", "indent": 1 },
      { "id": "p2", "due": "2026-08-02" }
    ],
    "expect": ["p2", "p1", "s1", "s2"] },

  { "name": "a leading indented row is its own block",
    "rows": [
      { "id": "x", "indent": 1 },
      { "id": "a", "due": "2026-08-01" }
    ],
    "expect": ["x", "a"] }
]
