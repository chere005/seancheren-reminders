{
  "step": [
    { "name": "a month step clamps jan 31 to feb 28",
      "start": "2026-01-31", "unit": "month", "n": 1, "i": 1, "expect": "2026-02-28" },
    { "name": "and springs back to the 31st where the month has one",
      "start": "2026-01-31", "unit": "month", "n": 1, "i": 2, "expect": "2026-03-31" },
    { "name": "a leap february clamps to the 29th",
      "start": "2024-01-31", "unit": "month", "n": 1, "i": 1, "expect": "2024-02-29" },
    { "name": "a year step off feb 29 clamps to the 28th",
      "start": "2024-02-29", "unit": "year", "n": 1, "i": 1, "expect": "2025-02-28" },
    { "name": "may 31 monthly lands on june 30",
      "start": "2026-05-31", "unit": "month", "n": 1, "i": 1, "expect": "2026-06-30" },
    { "name": "every 3 days, two steps out",
      "start": "2026-01-01", "unit": "day", "n": 3, "i": 2, "expect": "2026-01-07" },
    { "name": "every 2 weeks, one step",
      "start": "2026-08-01", "unit": "week", "n": 2, "i": 1, "expect": "2026-08-15" },
    { "name": "step zero is the start itself",
      "start": "2026-08-01", "unit": "week", "n": 2, "i": 0, "expect": "2026-08-01" }
  ],
  "window": [
    { "name": "a one-off inside the window is itself",
      "start": "2026-08-03", "repeat": null, "from": "2026-08-01", "to": "2026-08-31",
      "expect": ["2026-08-03"] },
    { "name": "a one-off outside the window is nothing",
      "start": "2026-07-03", "repeat": null, "from": "2026-08-01", "to": "2026-08-31",
      "expect": [] },
    { "name": "a daily rule fills the window even from before it",
      "start": "2026-07-30", "repeat": { "n": 1, "unit": "day" },
      "from": "2026-08-01", "to": "2026-08-05",
      "expect": ["2026-08-01", "2026-08-02", "2026-08-03", "2026-08-04", "2026-08-05"] },
    { "name": "monthly off the 31st clamps as it walks the window",
      "start": "2026-01-31", "repeat": { "n": 1, "unit": "month" },
      "from": "2026-01-01", "to": "2026-04-30",
      "expect": ["2026-01-31", "2026-02-28", "2026-03-31", "2026-04-30"] },
    { "name": "every 2 weeks across two months",
      "start": "2026-08-01", "repeat": { "n": 2, "unit": "week" },
      "from": "2026-08-01", "to": "2026-09-30",
      "expect": ["2026-08-01", "2026-08-15", "2026-08-29", "2026-09-12", "2026-09-26"] },
    { "name": "a backwards window is empty",
      "start": "2026-08-01", "repeat": { "n": 1, "unit": "day" },
      "from": "2026-08-31", "to": "2026-08-01", "expect": [] }
  ],
  "next": [
    { "name": "ticking rolls to the occurrence strictly after",
      "start": "2026-01-31", "unit": "month", "n": 1, "after": "2026-01-31",
      "expect": "2026-02-28" },
    { "name": "rolling from the clamped date finds the real 31st again",
      "start": "2026-01-31", "unit": "month", "n": 1, "after": "2026-02-28",
      "expect": "2026-03-31" },
    { "name": "a daily repeat rolls one day",
      "start": "2026-08-01", "unit": "day", "n": 1, "after": "2026-08-01",
      "expect": "2026-08-02" },
    { "name": "a weekly repeat rolls seven",
      "start": "2026-08-01", "unit": "week", "n": 1, "after": "2026-08-01",
      "expect": "2026-08-08" }
  ]
}
